@{
    ViewData["Title"] = "Reservaciones - La Bella Italia";
}

<div class="container py-5">
    <h2 class="mb-4 text-danger fw-bold">Reserva tu Mesa</h2>
    <p class="text-muted">Llena el siguiente formulario para asegurar tu lugar en el restaurante.</p>

    <!-- Alerta de éxito generada por el servidor -->
    @if (ViewBag.MensajeExito != null)
    {
        <div class="alert alert-success shadow-sm" role="alert">
            @ViewBag.MensajeExito
        </div>
    }

    <!-- Formulario con método POST hacia el controlador -->
    <form asp-action="Reserva" method="POST" class="card p-4 shadow-sm">
        <div class="mb-3">
            <label for="nombre" class="form-label">Nombre Completo:</label>
            <input type="text" id="nombre" name="NombreCliente" class="form-control" placeholder="Ej. Juan Pérez" required>
        </div>

        <div class="mb-3">
            <label for="correo" class="form-label">Correo Electrónico:</label>
            <input type="email" id="correo" name="Correo" class="form-control" placeholder="usuario@correo.com" required>
        </div>

        <div class="mb-3">
            <label for="fecha" class="form-label">Fecha de Reserva:</label>
            <input type="date" id="fecha" name="FechaReserva" class="form-control" required>
        </div>

        <div class="mb-3">
            <label for="personas" class="form-label">Número de Personas:</label>
            <input type="number" id="personas" name="NumPersonas" class="form-control" min="1" max="10" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Ubicación de la mesa:</label><br>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" id="interior" name="Zona" value="interior" required>
                <label class="form-check-label" for="interior">Salón Interior</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" id="terraza" name="Zona" value="terraza">
                <label class="form-check-label" for="terraza">Terraza</label>
            </div>
        </div>

        <button type="submit" class="btn btn-danger">Enviar Reservación</button>
    </form>
</div>